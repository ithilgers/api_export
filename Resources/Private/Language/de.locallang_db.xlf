            <trans-unit id="detailmap.storage_pid.description" resname="detailmap.storage_pid.description">
                <source>Folder whose items (events/news) link to the detail page selected below. Also applies to its subfolders.</source>
                <target>Ordner, dessen Items (Events/News) auf die unten gewählte Detailseite verlinken. Gilt auch für dessen Unterordner.</target>
            </trans-unit>
            <trans-unit id="detailmap.detail_pid" resname="detailmap.detail_pid">
                <source>Detail page</source>
                <target>Detailseite</target>
            </trans-unit>
            <trans-unit id="detailmap.detail_pid.description" resname="detailmap.detail_pid.description">
                <source>Page that items from the folder above link to.</source>
                <target>Seite, auf die Items aus dem o. g. Ordner verlinkt werden.</target>
            </trans-unit>
            <trans-unit id="flex.events.displayMode" resname="flex.events.displayMode">
