            <trans-unit id="feed.detail_map.description" resname="feed.detail_map.description">
                <source>Optional: a separate detail page per storage folder. An item inherits the detail page of its folder (including subfolders). Without a matching mapping, the detail page above applies.</source>
                <target>Optional: pro Storage-Ordner eine eigene Detailseite. Ein Item erbt die Detailseite seines Ordners (auch über Unterordner). Ohne passende Zuordnung gilt die Detailseite oben.</target>
            </trans-unit>
            <trans-unit id="feed.detail_map.add" resname="feed.detail_map.add">
