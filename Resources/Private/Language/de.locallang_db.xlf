                <target>Unbegrenzt</target>
            </trans-unit>
            <trans-unit id="feed.categories" resname="feed.categories">
                <source>Categories (filter)</source>
                <target>Kategorien (Filter)</target>
            </trans-unit>
            <trans-unit id="feed.categories.description" resname="feed.categories.description">
                <source>Include or exclude records with these categories (see conjunction), like the category setting of the list plugin. Empty = no category filter.</source>
                <target>Datensätze mit diesen Kategorien einschließen oder ausschließen (siehe Verknüpfung) – wie die Kategorie-Einstellung im Listen-Plugin. Leer = kein Kategorie-Filter.</target>
            </trans-unit>
            <trans-unit id="feed.category_conjunction" resname="feed.category_conjunction">
                <source>Category conjunction</source>
                <target>Kategorie-Verknüpfung</target>
            </trans-unit>
            <trans-unit id="feed.category_conjunction.or" resname="feed.category_conjunction.or">
                <source>At least one of the categories (OR)</source>
                <target>Mindestens eine der Kategorien (ODER)</target>
            </trans-unit>
            <trans-unit id="feed.category_conjunction.and" resname="feed.category_conjunction.and">
                <source>All categories (AND)</source>
                <target>Alle Kategorien (UND)</target>
            </trans-unit>
            <trans-unit id="feed.category_conjunction.notor" resname="feed.category_conjunction.notor">
                <source>None of the categories (NOT OR)</source>
                <target>Keine der Kategorien (NICHT ODER)</target>
            </trans-unit>
            <trans-unit id="feed.category_conjunction.notand" resname="feed.category_conjunction.notand">
                <source>Not all categories at once (NOT AND)</source>
                <target>Nicht alle Kategorien zugleich (NICHT UND)</target>
            </trans-unit>
            <trans-unit id="feed.category_include_subcategories" resname="feed.category_include_subcategories">
