            <trans-unit id="feed.storage_pages" resname="feed.storage_pages">
                <source>Storage folders</source>
                <target>Storage-Ordner</target>
            </trans-unit>
            <trans-unit id="feed.storage_pages.description" resname="feed.storage_pages.description">
                <source>Pages/folders the records are taken from. Empty = no data.</source>
                <target>Seiten/Ordner, aus denen die Datensätze stammen. Leer = keine Daten.</target>
            </trans-unit>
            <trans-unit id="feed.recursive" resname="feed.recursive">
                <source>Include subfolders</source>
                <target>Unterordner einbeziehen</target>
            </trans-unit>
            <trans-unit id="feed.recursive.description" resname="feed.recursive.description">
                <source>Also include subpages/subfolders of the selected storage folders (recursion depth).</source>
                <target>Auch Unterseiten/-ordner der gewählten Storage-Ordner einbeziehen (Rekursionstiefe).</target>
            </trans-unit>
            <trans-unit id="feed.recursive.0" resname="feed.recursive.0">
                <source>No (selected folders only)</source>
                <target>Nein (nur gewählte Ordner)</target>
            </trans-unit>
            <trans-unit id="feed.recursive.1" resname="feed.recursive.1">
                <source>1 level</source>
                <target>1 Ebene</target>
            </trans-unit>
            <trans-unit id="feed.recursive.2" resname="feed.recursive.2">
                <source>2 levels</source>
                <target>2 Ebenen</target>
            </trans-unit>
            <trans-unit id="feed.recursive.3" resname="feed.recursive.3">
