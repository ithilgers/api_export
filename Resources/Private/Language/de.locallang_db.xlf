                <target>Detailseite</target>
            </trans-unit>
            <trans-unit id="feed.detail_pid.description" resname="feed.detail_pid.description">
                <source>Target of the item links unless a folder mapping below applies. Empty = no link.</source>
                <target>Ziel der Item-Links, sofern unten keine ordnerweise Zuordnung greift. Leer = kein Link.</target>
