            <trans-unit id="client.token" resname="client.token">
                <source>Token</source>
            </trans-unit>
            <trans-unit id="client.token.description" resname="client.token.description">
                <source>Secret token this client sends in the HTTP header. It is generated by the system and shown only once, when the client is created or a new token is generated. Only its hash and its last 4 characters are stored. A copied client gets no usable token and stays deactivated.</source>
            </trans-unit>
            <trans-unit id="client.token.newHint" resname="client.token.newHint">
                <source>Copy this token now and pass it on to the consumer. It is shown only now: after saving, only its last 4 characters are visible.</source>
            </trans-unit>
            <trans-unit id="client.token.stored" resname="client.token.stored">
                <source>A token is stored, it ends with %s.</source>
            </trans-unit>
            <trans-unit id="client.token.none" resname="client.token.none">
                <source>No usable token is stored (e.g. because the client was copied). Generate a new token to use this client.</source>
            </trans-unit>
            <trans-unit id="client.token.regenerate" resname="client.token.regenerate">
                <source>Generate new token</source>
            </trans-unit>
            <trans-unit id="client.token.regenerateHint" resname="client.token.regenerateHint">
                <source>Copy the new token now. Saving replaces the previous token, which stops working immediately. Close without saving to keep the previous token.</source>
            </trans-unit>
            <trans-unit id="client.token.copy" resname="client.token.copy">
                <source>Copy token</source>
            </trans-unit>
